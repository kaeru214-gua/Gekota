<Window x:Class="Gekota.WPF.NewMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:l="https://github.com/XAMLMarkupExtensions/WPFLocalizationExtension"
        l:LocalizeDictionary.DesignCulture=""
        l:ResxLocalizationProvider.DefaultAssembly="Gekota.WPF"
        l:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:local="clr-namespace:Gekota.WPF"
        xmlns:pages="clr-namespace:Gekota.WPF.Pages"
        mc:Ignorable="d"
        Title="Gekota"
        Background="Transparent"
        Foreground="{DynamicResource MacTextPrimaryBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource MacFontFamily}"
        ui:ThemeManager.IsThemeAware="True"
        Width="1152" Height="768"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <pages:RootPage x:Name="RootPage" />
</Window>
