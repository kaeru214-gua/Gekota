<Window x:Class="Gekota.WPF.Controls.NativeLiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:local="clr-namespace:Gekota.WPF.Controls"
        mc:Ignorable="d"
        Title="Gekota 原生播放"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#0B0B0E"
        Foreground="#F2F2F5"
        WindowStyle="SingleBorderWindow"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#151519" BorderBrush="#2A2A31" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="原生播放" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="连接中…" Margin="12,0,0,0"
                               Foreground="#8F8F98" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="画质" Foreground="#8F8F98" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="QualityBox" Width="120" Height="28"
                              SelectionChanged="QualityBox_SelectionChanged" />
                    <Button x:Name="FullscreenButton" Content="全屏" Width="56" Height="28" Margin="10,0,0,0"
                            Click="FullscreenButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <vlc:VideoView x:Name="Video" Grid.Column="0" Background="#000000">
                <vlc:VideoView.Content>
                    <Grid>
                        <Canvas x:Name="DanmakuCanvas" IsHitTestVisible="False" />
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16"
                                Background="#66000000" CornerRadius="7" Padding="9,5">
                            <TextBlock x:Name="OverlayTitle" Foreground="White" FontSize="13" />
                        </Border>
                        <Button x:Name="PlayButton" Content="▶" Width="42" Height="42"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="#99000000" Foreground="White" BorderThickness="0"
                                Click="PlayButton_Click" />
                    </Grid>
                </vlc:VideoView.Content>
            </vlc:VideoView>

            <Grid Grid.Column="1" Background="#111114">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border BorderBrush="#24242B" BorderThickness="0,0,0,1" Padding="13,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="实时弹幕" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="ChatState" Text="连接中…" Margin="8,0,0,0"
                                   Foreground="#8F8F98" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="ChatList" Grid.Row="1" Margin="6"
                         Background="Transparent" BorderThickness="0"
                         Foreground="#E8E8EE" FontSize="12.5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="4,2">
                                <Run Text="{Binding User}" Foreground="#7FA7FF" FontWeight="SemiBold" />
                                <Run Text="：" />
                                <Run Text="{Binding Text}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2" Margin="10,4,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ChatInput" Height="32" MaxLength="30"
                             VerticalContentAlignment="Center"
                             Background="#1B1B20" Foreground="#F2F2F5"
                             BorderBrush="#303038" KeyDown="ChatInput_KeyDown" />
                    <Button x:Name="SendButton" Grid.Column="1" Content="发送" Height="32" Margin="7,0,0,0"
                            Click="SendButton_Click" />
                </Grid>
                <TextBlock x:Name="SendState" Grid.Row="3" Margin="12,5,12,8"
                           Foreground="#8F8F98" FontSize="11" />
            </Grid>
        </Grid>
    </Grid>
</Window>
