<ui:ContentDialog
    x:Class="Gekota.WPF.Controls.CloseWindowConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:l="https://github.com/XAMLMarkupExtensions/WPFLocalizationExtension"
    l:LocalizeDictionary.DesignCulture=""
    l:ResxLocalizationProvider.DefaultAssembly="Gekota.WPF"
    l:ResxLocalizationProvider.DefaultDictionary="Strings"
    xmlns:local="clr-namespace:Gekota.WPF.Controls"
    Background="{DynamicResource MacDockBrush}"
    BorderBrush="Transparent"
    BorderThickness="0"
    CornerRadius="21"
    mc:Ignorable="d">
    <ui:ContentDialog.Resources>
        <ControlTemplate x:Key="GlassDialogButtonTemplate" TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="GlassDialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="145" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template" Value="{StaticResource GlassDialogButtonTemplate}" />
            <Setter Property="Background" Value="#80FFFFFF" />
            <Setter Property="BorderBrush" Value="#4DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#1D1D1F" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="GlassDialogPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="145" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Template" Value="{StaticResource GlassDialogButtonTemplate}" />
            <Setter Property="Background" Value="#800A5CD8" />
            <Setter Property="BorderBrush" Value="#4DFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#0A2A66" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ui:ContentDialog.Resources>

    <ui:ContentDialog.Template>
        <ControlTemplate TargetType="ui:ContentDialog">
            <Grid>
                <Border Background="#66000000" CornerRadius="21" Margin="1" />
                <Border Background="{DynamicResource MacCardBrush}"
                        BorderBrush="{DynamicResource MacBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Width="300"
                        Height="200"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="18,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.22" Color="#000000" />
                    </Border.Effect>
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </Grid>
        </ControlTemplate>
    </ui:ContentDialog.Template>

    <Grid Height="172">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="{l:Loc CloseWindowConfirmDialog_Title}"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="22" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Style="{StaticResource GlassDialogPrimaryButtonStyle}"
                    Width="112" Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{l:Loc Global_Quit}"
                    Click="ExitButton_Click" />
            <Button Grid.Column="1"
                    Style="{StaticResource GlassDialogButtonStyle}"
                    Width="112" Height="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{l:Loc Global_Cancel}"
                    Click="CancelButton_Click" />
        </Grid>
    </Grid>
</ui:ContentDialog>
