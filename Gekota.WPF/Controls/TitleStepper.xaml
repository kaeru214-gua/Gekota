<UserControl
    x:Class="Gekota.WPF.Controls.TitleStepper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="32" d:DesignWidth="200">
    <StackPanel Orientation="Horizontal" Margin="0,0,10,5" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Border CornerRadius="4" Background="#22808080" BorderBrush="#33808080" BorderThickness="1" Padding="2" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="MinusButton" Content="&#x2212;" Width="24" Height="24"
                        Padding="0" BorderThickness="0" Background="Transparent"
                        FontSize="14" Click="Minus_Click"/>
                <TextBox x:Name="ValueBox" Width="52" TextAlignment="Center"
                         BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center" FontSize="13"
                         LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                <Button x:Name="PlusButton" Content="+" Width="24" Height="24"
                        Padding="0" BorderThickness="0" Background="Transparent"
                        FontSize="14" Click="Plus_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
