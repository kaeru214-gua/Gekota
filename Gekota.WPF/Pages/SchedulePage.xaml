<ui:Page
    x:Class="Gekota.WPF.Pages.SchedulePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:Gekota.WPF.Pages"
    mc:Ignorable="d"
    d:DesignWidth="1100" d:DesignHeight="760"

    DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=local:RootPage}, Path=DataContext.Recorder, Mode=OneWay}"
    Title="SchedulePage">
    <ui:Page.Resources>
        <Style x:Key="ScheduleSkipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#D9FFFFFF" />
            <Setter Property="BorderBrush" Value="#B0FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#33343A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#F2FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="#F8FFFFFF" BorderBrush="#22000000"
                                BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="8,0" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CalendarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{DynamicResource MacAccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </ui:Page.Resources>
    <Grid Margin="0,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部主播栏 -->
        <Border Background="{DynamicResource MacDockBrush}" CornerRadius="21" Padding="14,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6"
                                  Opacity="0.24" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="44" Height="44" Margin="0,0,10,0"
                        Background="#66FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1"
                        Cursor="Hand" ToolTip="刷新日程" Click="RefreshButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#CCFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:PathIcon Style="{StaticResource PathIconDataRefresh}" Width="18" Height="18"
                                 Foreground="#22242A" />
                </Button>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <ListBox x:Name="StreamerBar"
                             SelectionChanged="StreamerBar_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder"
                                                    Width="48" Height="48"
                                                    CornerRadius="14"
                                                    BorderThickness="2"
                                                    BorderBrush="Transparent"
                                                    Padding="0">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush"
                                                            Value="{DynamicResource MacAccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#12000000" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="44" Height="44">
                                    <Border CornerRadius="13" ClipToBounds="True"
                                            Background="{Binding TileBrush}" />
                                    <Path x:Name="AllIcon"
                                          Data="M7.5,11A3.5,3.5 0 1,0 4,7.5A3.5,3.5 0 0,0 7.5,11M16.5,11A3.5,3.5 0 1,0 13,7.5A3.5,3.5 0 0,0 16.5,11M7.5,13C5,13 0,14.25 0,16.75V20H15V16.75C15,14.25 10,13 7.5,13M16.5,13C16.13,13 15.7,13.03 15.25,13.08C16.56,14.03 17.5,15.2 17.5,16.75V20H24V16.75C24,14.25 19,13 16.5,13Z"
                                          Fill="#1A1A1E" Width="23" Height="23"
                                          Stretch="Uniform" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock x:Name="InitialText"
                                               Text="{Binding Initial}"
                                               Foreground="White" FontSize="21" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAll}" Value="True">
                                        <Setter TargetName="AllIcon" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                        <Setter TargetName="InitialText" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 周日程表 -->
        <!-- 日历链接 -->
        <Border x:Name="CalendarBar" Grid.Row="1" VerticalAlignment="Center" Panel.ZIndex="80" Width="620" HorizontalAlignment="Center" Margin="16" Padding="12,10"
                Background="#D9FFFFFF" CornerRadius="16"
                BorderBrush="#28000000" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="日历链接" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                <TextBox x:Name="CalendarUrlBox" Grid.Column="1" Margin="10,0,10,0"
                         Style="{StaticResource CalendarInputStyle}"
                         ToolTip="A-SOUL / 闪耀舞台日历 ICS 链接" />
                <Button Grid.Column="2" Content="导入" Click="ImportCalendar_Click" Style="{StaticResource CalendarButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource MacDockBrush}" CornerRadius="21" Margin="0,12,0,0" Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6"
                                  Opacity="0.24" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="DayHeader" />
                <Grid x:Name="WeekGrid" Grid.Row="1" />
            </Grid>
        </Border>

        <Border x:Name="LoadingOverlay"
                Grid.RowSpan="2"
                Panel.ZIndex="100"
                Background="#CCF7F7FA"
                CornerRadius="21">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                <TextBlock Text="正在加载..."
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#555862"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</ui:Page>
