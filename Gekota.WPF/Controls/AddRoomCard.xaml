<UserControl
    x:Class="Gekota.WPF.Controls.AddRoomCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:l="https://github.com/XAMLMarkupExtensions/WPFLocalizationExtension"
    l:LocalizeDictionary.DesignCulture=""
    l:ResxLocalizationProvider.DefaultAssembly="Gekota.WPF"
    l:ResxLocalizationProvider.DefaultDictionary="Strings"
    xmlns:local="clr-namespace:Gekota.WPF.Controls"
    mc:Ignorable="d" 
    d:DesignHeight="110" d:DesignWidth="210">
    <Border Background="{DynamicResource MacDockBrush}"
            BorderBrush="Transparent"
            BorderThickness="0"
            CornerRadius="21">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3.5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.ColumnSpan="2">
                <ui:PathIcon Margin="5" Foreground="{DynamicResource MacTextPrimaryBrush}" Style="{StaticResource PathIconDataPlus}"/>
                <TextBlock FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource MacTextPrimaryBrush}"
                           Text="{l:Loc AddRoomCard_Title}"/>
            </StackPanel>

            <!-- 输入框 -->
            <TextBox Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:Name="InputTextBox"
                     ui:TextBoxHelper.IsDeleteButtonVisible="False"
                     ui:ControlHelper.CornerRadius="8"
                     FontSize="{l:Loc AddRoomCard_PlaceholderText_FontSize}"
                     ui:ControlHelper.PlaceholderText="{l:Loc AddRoomCard_PlaceholderText}"
                     Background="{DynamicResource MacFieldBrush}" Foreground="{DynamicResource MacTextPrimaryBrush}" BorderThickness="0" BorderBrush="Transparent" CaretBrush="{DynamicResource MacTextPrimaryBrush}"
                     KeyDown="InputTextBox_KeyDown">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8E8E93"/>
                </TextBox.Resources>
            </TextBox>

            <!-- 确认按钮：与卡片相同透明度的蓝色磨砂玻璃 -->
            <Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                    ui:ControlHelper.CornerRadius="8"
                    Padding="14,6" MinWidth="64" MinHeight="32" FontSize="14"
                    Content="{l:Loc AddRoomCard_ConfirmButton}" Click="Button_Click"
                    Background="#800A5CD8" Foreground="#0A2A66" FontWeight="SemiBold" BorderThickness="0" BorderBrush="Transparent">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>
