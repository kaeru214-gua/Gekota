<Window x:Class="Gekota.WPF.Controls.TutorialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用教程"
        Width="700" Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="#F8F8FA" BorderBrush="#24000000" BorderThickness="1"
            CornerRadius="20" Padding="26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="7" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Gekota 使用教程" FontSize="24" FontWeight="Bold"
                           FontFamily="Microsoft YaHei" Foreground="#202126"/>
                <TextBlock Text="第一次使用建议按下面顺序操作。" Margin="0,6,0,0"
                           FontSize="13" FontFamily="Microsoft YaHei" Foreground="#777781"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="1. 登录与添加直播间" FontSize="17" FontWeight="Bold"
                               FontFamily="Microsoft YaHei" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13.5"
                               Foreground="#4C4E57" LineHeight="22"
                               Text="在「用户」页面扫码登录哔哩哔哩。回到首页后点击「添加房间」，输入房间号或直播间链接即可添加。添加后会出现在首页卡片中。"/>

                    <TextBlock Text="2. 播放模式 / 录制模式" FontSize="17" FontWeight="Bold"
                               FontFamily="Microsoft YaHei" Margin="0,18,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13.5"
                               Foreground="#4C4E57" LineHeight="22"
                               Text="设置 → 通用顶部有「播放模式」和「录制模式」。默认是播放模式，只观看、不自动录制；切换到录制模式后才会启用自动录制、分段、压制、上传等录制相关设置。两种模式互斥。"/>

                    <TextBlock Text="3. 首页与监控室" FontSize="17" FontWeight="Bold"
                               FontFamily="Microsoft YaHei" Margin="0,18,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13.5"
                               Foreground="#4C4E57" LineHeight="22"
                               Text="首页卡片右侧三个点可以设置标签、编辑简介、打开直播间或修改单房间设置。标签和简介会写入主播文件夹下的 tag.txt 和 简介.txt，自动上传时使用。监控室最多同时显示 9 个直播间，左侧优先显示正在直播的房间；每个格子可以单独静音，点击进入播放页。"/>

                    <TextBlock Text="4. 播放器" FontSize="17" FontWeight="Bold"
                               FontFamily="Microsoft YaHei" Margin="0,18,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13.5"
                               Foreground="#4C4E57" LineHeight="22"
                               Text="播放页支持音量、静音、画质、飞屏弹幕、弹幕不重合、特殊弹幕、自动滚动和发送弹幕。音量和弹幕设置会自动记住，下次进入不需要重新调整。特殊弹幕（SC）使用小尺寸、85% 透明度显示。"/>

                    <TextBlock Text="5. 日程表" FontSize="17" FontWeight="Bold"
                               FontFamily="Microsoft YaHei" Margin="0,18,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13.5"
                               Foreground="#4C4E57" LineHeight="22"
                               Text="普通主播的日程从 B 站动态、B 站直播预约和微博公开动态获取。"/>

                    <Border Background="#140078D4" BorderBrush="#330078D4" BorderThickness="1"
                            CornerRadius="10" Padding="12,10" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="A-SOUL / 闪耀舞台" FontWeight="Bold"
                                       FontFamily="Microsoft YaHei" FontSize="14" Foreground="#0B5FA5"/>
                            <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13"
                                       Foreground="#3F4652" LineHeight="21" Margin="0,4,0,0"
                                       Text="只有 A-SOUL 和闪耀舞台成员使用 ICS 日历数据。需要在日程页导入日历链接。推荐打开「枝江日程表」获取日历链接："/>
                            <TextBlock Margin="0,4,0,0" FontFamily="Microsoft YaHei" FontSize="13"
                                       Foreground="#0B5FA5" Text="https://asoul.love/calendar"/>
                            <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="12"
                                       Foreground="#666870" Margin="0,4,0,0"
                                       Text="从枝江日程表页面复制 ICS 订阅链接，粘贴到 Gekota 日程页并点击「导入」。未添加 A-SOUL / 闪耀舞台成员时不会提示导入。日程中过去的时间显示「已结束」。"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="6. 动态" FontSize="17" FontWeight="Bold"
                               FontFamily="Microsoft YaHei" Margin="0,18,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13.5"
                               Foreground="#4C4E57" LineHeight="22"
                               Text="「动态」页面集中浏览已添加主播的 B 站动态，支持按主播筛选和图片查看。"/>

                    <TextBlock Text="7. 录制与后处理" FontSize="17" FontWeight="Bold"
                               FontFamily="Microsoft YaHei" Margin="0,18,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13.5"
                               Foreground="#4C4E57" LineHeight="22"
                               Text="开启录制模式后，主播开播会自动录制。标题变化会自动分段；网络断流产生的同标题分段会在直播结束后自动合并，弹幕时间轴也会一起合并。默认优先 IPv4，失败自动回退。后处理可以自动转封装、转换弹幕、压制纯净版/弹幕版。"/>

                    <TextBlock Text="8. 工具箱" FontSize="17" FontWeight="Bold"
                               FontFamily="Microsoft YaHei" Margin="0,18,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13.5"
                               Foreground="#4C4E57" LineHeight="22"
                               Text="工具箱包含录播修复、弹幕合并、弹幕转换、视频压制和转封装。弹幕转换设置可以直接点「保存设置」，不需要先转换文件。"/>

                    <TextBlock Text="9. 自动上传" FontSize="17" FontWeight="Bold"
                               FontFamily="Microsoft YaHei" Margin="0,18,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13.5"
                               Foreground="#4C4E57" LineHeight="22"
                               Text="设置 → 录制结束后自动化可以开启自动上传。视频标题模板默认是 {title}，支持 {streamer}、{date}、{time}、{roomId}。简介和标签读取主播文件夹的 简介.txt、tag.txt。没有当前主播的防撞视频时会跳过自动上传。A-SOUL、双播、心宜思诺的标题、简介和标签会自动合并对应成员资料并去重。"/>

                    <TextBlock Text="10. 设置与声明" FontSize="17" FontWeight="Bold"
                               FontFamily="Microsoft YaHei" Margin="0,18,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontFamily="Microsoft YaHei" FontSize="13.5"
                               Foreground="#4C4E57" LineHeight="22"
                               Text="设置里可以调整主题色、背景、录制参数、日志等。详细声明、开源协议和感谢名单在「设置 → 声明 / 关于」中查看。"/>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="开始使用" Width="110" Height="34"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
