<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019">

    <!-- ============================================================
         macOS 风格基础资源
         MacTheme.cs 会在浅色/深色主题与皮肤色变化时替换这些画刷。
         ============================================================ -->

    <FontFamily x:Key="MacFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MacDisplayFontFamily">Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="MacMonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="MacTextPrimaryBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="MacTextSecondaryBrush" Color="#6E6E73" />
    <SolidColorBrush x:Key="MacTextTertiaryBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="MacAccentBrush" Color="#0A84FF" />
    <SolidColorBrush x:Key="MacAccentSoftBrush" Color="#260A84FF" />
    <SolidColorBrush x:Key="MacOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MacDangerBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="MacSuccessBrush" Color="#30D158" />
    <SolidColorBrush x:Key="MacWarningBrush" Color="#FF9F0A" />

    <SolidColorBrush x:Key="MacContentBrush" Color="#D9F7F7F9" />
    <SolidColorBrush x:Key="MacCardBrush" Color="#C7FFFFFF" />
    <SolidColorBrush x:Key="MacFieldBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="MacControlBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="MacControlHoverBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="MacBorderBrush" Color="#26000000" />
    <SolidColorBrush x:Key="MacStrongBorderBrush" Color="#3D000000" />
    <SolidColorBrush x:Key="MacSeparatorBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="MacHoverBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="MacPressedBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="MacMenuBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="MacMenuHoverBrush" Color="#12000000" />
    <SolidColorBrush x:Key="MacTrackBrush" Color="#2E000000" />
    <SolidColorBrush x:Key="MacDisabledBrush" Color="#80FFFFFF" />

    <SolidColorBrush x:Key="MacDockIconBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MacDockIconForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="MacDockIconHoverBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="MacDockIndicatorBrush" Color="#1D1D1F" />
    <SolidColorBrush x:Key="MacDockBrush" Color="#80E2E2E7" />
    <!-- 房间卡片 / 添加卡片：与 Dock 相同透明度的白色玻璃 -->
    <LinearGradientBrush x:Key="MacCardGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D1FFFFFF" Offset="0" />
        <GradientStop Color="#A8FFFFFF" Offset="1" />
    </LinearGradientBrush>
    <!-- 添加房间卡片：比顶部菜单栏稍深一点点的浅色玻璃 -->
    <LinearGradientBrush x:Key="MacAddCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F8F9FBFF" Offset="0" />
        <GradientStop Color="#F2F4F7FA" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MacDockSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#59FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="MacWindowTintBrush" Color="#B3F3F3F5" />
    <SolidColorBrush x:Key="MacWindowBaseBrush" Color="#FFF2F3F7" />
    <SolidColorBrush x:Key="MacChromeBrush" Color="#CCF7F7F9" />

    <!-- ============================================================
         文本
         ============================================================ -->

    <Style x:Key="MacTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MacDisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="MacHeadlineTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource MacDisplayFontFamily}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextPrimaryBrush}" />
    </Style>

    <Style x:Key="MacSubheadTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextSecondaryBrush}" />
    </Style>

    <Style x:Key="MacCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextSecondaryBrush}" />
    </Style>

    <!-- ============================================================
         按钮
         ============================================================ -->

    <Style x:Key="MacAccentButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource MacAccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MacOnAccentBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MacFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacQuietButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MacFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MacHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MacPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 纯图标 / 视频控制按钮 -->
    <Style x:Key="MacGlyphButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MacHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MacPressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         输入框
         ============================================================ -->

    <!-- ============================================================
         ComboBox
         ============================================================ -->

    <!-- ============================================================
         CheckBox / RadioButton
         ============================================================ -->

    <!-- ============================================================
         ToggleSwitch：macOS 风格的胶囊开关
         ============================================================ -->

    <Style x:Key="MacToggleSwitchStyle" TargetType="{x:Type ui:ToggleSwitch}">
        <Setter Property="Foreground" Value="{DynamicResource MacTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MacFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ToggleSwitch}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="38" Height="22" VerticalAlignment="Center">
                            <Border x:Name="Track"
                                    Width="38" Height="22"
                                    CornerRadius="11"
                                    Background="{DynamicResource MacTrackBrush}"
                                    BorderBrush="{DynamicResource MacBorderBrush}"
                                    BorderThickness="1" />
                            <ToggleButton x:Name="SwitchButton"
                                          Width="38" Height="22"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid Background="Transparent">
                                            <Border x:Name="Knob"
                                                    Width="18" Height="18"
                                                    Margin="2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="#FFFFFF"
                                                    CornerRadius="9">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.25" Color="#000000" />
                                                </Border.Effect>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>

                        <ContentPresenter x:Name="OnContentHost"
                                          Content="{TemplateBinding OnContent}"
                                          Margin="9,0,0,0"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed" />
                        <ContentPresenter x:Name="OffContentHost"
                                          Content="{TemplateBinding OffContent}"
                                          Margin="9,0,0,0"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource MacAccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource MacAccentBrush}" />
                            <Setter TargetName="OnContentHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="OffContentHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         GroupBox：macOS 设置分组卡片
         ============================================================ -->

    <!-- ============================================================
         ProgressBar / Slider
         ============================================================ -->

    <Style x:Key="MacInvisibleRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         列表
         ============================================================ -->

    <Style x:Key="MacListItemBaseStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MacTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MacFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="Margin" Value="2,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MacHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MacAccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         DataGrid：保持轻量，仅替换颜色
         ============================================================ -->

    <Style x:Key="MacProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MacAccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{DynamicResource MacTrackBrush}" CornerRadius="3" />
                        <Border x:Name="PART_Track" Background="Transparent" CornerRadius="3" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource MacAccentBrush}"
                                CornerRadius="3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MacSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="26" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="26">
                        <Border Height="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource MacTrackBrush}"
                                CornerRadius="2" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource MacInvisibleRepeatButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="#66000000" Width="18" Height="18" Margin="0,2,0,0" />
                                                <Ellipse x:Name="Knob" Fill="#FFFFFF" Stroke="#33000000" StrokeThickness="1" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource MacAccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource MacInvisibleRepeatButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         菜单 / 右键菜单
         ============================================================ -->

    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource MacFontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Menu">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource MacMenuBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MacBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource MacFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="MinWidth" Value="190" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="9"
                            Padding="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.20" Color="#000000" />
                        </Border.Effect>
                        <ScrollViewer MaxHeight="560"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource MacTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MacFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <Border x:Name="Bg"
                                Margin="3,1"
                                Background="Transparent"
                                CornerRadius="7" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost"
                                              Grid.Column="0"
                                              ContentSource="Icon"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            <Path x:Name="CheckGlyph"
                                  Grid.Column="0"
                                  Width="11" Height="9"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  Stretch="Fill"
                                  Stroke="{DynamicResource MacTextPrimaryBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M 0,4.5 L 3.5,8 L 11,0" />
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                            <Path x:Name="SubmenuGlyph"
                                  Grid.Column="2"
                                  Width="5" Height="9"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"
                                  Stretch="Fill"
                                  Fill="{DynamicResource MacTextSecondaryBrush}"
                                  Data="M 0,0 L 5,4.5 L 0,9 Z" />
                        </Grid>

                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}"
                               Placement="Right"
                               HorizontalOffset="-4"
                               VerticalOffset="-5"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                            <Border Margin="9"
                                    MinWidth="190"
                                    Padding="4"
                                    Background="{DynamicResource MacMenuBrush}"
                                    BorderBrush="{DynamicResource MacBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.20" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="520"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="SubmenuGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuItem">
                            <Setter TargetName="SubmenuGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="SubmenuGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MacMenuHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:RadioMenuItem}"
           BasedOn="{StaticResource {x:Type MenuItem}}" />

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="10,5" Background="{DynamicResource MacSeparatorBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         ToolTip
         ============================================================ -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontFamily" Value="{DynamicResource MacFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="4"
                            Padding="8,4"
                            Background="#E61E1E20"
                            CornerRadius="7">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         皮肤色块
         ============================================================ -->

    <Style x:Key="MacSwatchRadioStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="54" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Swatch"
                                CornerRadius="14"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#33000000"
                                BorderThickness="1" />
                        <Border x:Name="Ring"
                                CornerRadius="17"
                                BorderBrush="Transparent"
                                BorderThickness="2.5"
                                Margin="-4" />
                        <Path x:Name="Check"
                              Width="15" Height="12"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              Stretch="Fill"
                              Stroke="#FFFFFF"
                              StrokeThickness="2.2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Data="M 0,6 L 5,11 L 15,0">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="3" ShadowDepth="0" Opacity="0.55" Color="#000000" />
                            </Path.Effect>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource MacTextPrimaryBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Swatch" Property="Opacity" Value="0.82" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
