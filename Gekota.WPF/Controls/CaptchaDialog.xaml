<Window x:Class="Gekota.WPF.Controls.CaptchaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="B站验证码" Width="440" Height="560" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <wv2:WebView2 x:Name="WebView"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="完成验证" Click="Done_Click" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="取消" Click="Cancel_Click" Padding="12,4"/>
        </StackPanel>
    </Grid>
</Window>
