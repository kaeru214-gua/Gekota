<UserControl
    x:Class="Gekota.WPF.Controls.DockIcon"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:Gekota.WPF.Controls"
    mc:Ignorable="d"
    d:DesignWidth="72" d:DesignHeight="72"
    Width="72" Height="72"
    Background="Transparent"
    Cursor="Hand"
    ToolTipService.InitialShowDelay="260"
    ToolTipService.BetweenShowDelay="80"
    ToolTip="{Binding Label, ElementName=Root}"
    MouseLeftButtonUp="Root_MouseLeftButtonUp">

    <Grid>
        <!-- 图标磁贴：圆角正方形，白底黑图案（默认皮肤） -->
        <Border x:Name="Tile"
                Width="58" Height="58"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource MacFieldBrush}"
                BorderBrush="Transparent"
                BorderThickness="0"
                CornerRadius="16"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="TileShadow"
                                  BlurRadius="10"
                                  Direction="270"
                                  ShadowDepth="2"
                                  Opacity="0.20"
                                  Color="#000000" />
            </Border.Effect>
            <ui:PathIcon x:Name="Glyph"
                         Width="30" Height="30"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MacTextPrimaryBrush}"
                         Style="{Binding IconStyle, ElementName=Root}" />
        </Border>

        <!-- 角标 -->
        <Border x:Name="BadgeHost"
                MinWidth="17" Height="17"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,1,2,0"
                Padding="5,0"
                Background="{DynamicResource MacDangerBrush}"
                CornerRadius="9"
                Visibility="Collapsed">
            <TextBlock x:Name="BadgeText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="10"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1.10" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1.10" Duration="0:0:0.14" />
                    <DoubleAnimation Storyboard.TargetName="TileShadow"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.32" Duration="0:0:0.14" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1.0" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1.0" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="TileShadow"
                                     Storyboard.TargetProperty="Opacity"
                                     To="0.20" Duration="0:0:0.16" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeftButtonDown">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="0.94" Duration="0:0:0.06" />
                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="0.94" Duration="0:0:0.06" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeftButtonUp">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1.10" Duration="0:0:0.10" />
                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1.10" Duration="0:0:0.10" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
