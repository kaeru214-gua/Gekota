<ui:Page
    x:Class="Gekota.WPF.Pages.DynamicsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:Gekota.WPF.Pages"
    mc:Ignorable="d"
    d:DesignWidth="1100" d:DesignHeight="760"

    DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=local:RootPage}, Path=DataContext.Recorder, Mode=OneWay}"
    Title="DynamicsPage">
    <Grid Margin="0,24,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部主播栏 -->
        <Border Background="{DynamicResource MacDockBrush}" CornerRadius="21" Padding="14,12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6"
                                  Opacity="0.24" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="44" Height="44" Margin="0,0,10,0"
                        Background="#66FFFFFF" BorderBrush="#80FFFFFF" BorderThickness="1"
                        Cursor="Hand" ToolTip="刷新动态" Click="RefreshButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="13">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#CCFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <ui:PathIcon Style="{StaticResource PathIconDataRefresh}" Width="18" Height="18"
                                 Foreground="#22242A" />
                </Button>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                <ListBox x:Name="StreamerBar"
                         SelectionChanged="StreamerBar_SelectionChanged"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Width="48" Height="48"
                                                CornerRadius="14"
                                                BorderThickness="2"
                                                BorderBrush="Transparent"
                                                Padding="0">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="BorderBrush"
                                                        Value="{DynamicResource MacAccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#12000000" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="44" Height="44">
                                <Border CornerRadius="13" ClipToBounds="True"
                                        Background="{Binding TileBrush}" />
                                <Path x:Name="AllIcon"
                                      Data="M7.5,11A3.5,3.5 0 1,0 4,7.5A3.5,3.5 0 0,0 7.5,11M16.5,11A3.5,3.5 0 1,0 13,7.5A3.5,3.5 0 0,0 16.5,11M7.5,13C5,13 0,14.25 0,16.75V20H15V16.75C15,14.25 10,13 7.5,13M16.5,13C16.13,13 15.7,13.03 15.25,13.08C16.56,14.03 17.5,15.2 17.5,16.75V20H24V16.75C24,14.25 19,13 16.5,13Z"
                                      Fill="#1A1A1E" Width="23" Height="23"
                                      Stretch="Uniform" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="InitialText"
                                           Text="{Binding Initial}"
                                           Foreground="White" FontSize="21" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAll}" Value="True">
                                    <Setter TargetName="AllIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="InitialText" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                    <Setter TargetName="InitialText" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
            </Grid>
        </Border>

        <!-- 动态列表 -->
        <Border Grid.Row="1" Background="{DynamicResource MacDockBrush}" CornerRadius="21"
                Margin="0,24,0,0" Padding="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="270" ShadowDepth="6"
                                  Opacity="0.24" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="动态" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Foreground="#333333" FontSize="12"
                               VerticalAlignment="Center" Margin="12,4,0,0" Text="正在读取…" />
                </StackPanel>
                <ScrollViewer x:Name="FeedScroll" Grid.Row="1" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto"
                              IsDeferredScrollingEnabled="False"
                              PreviewMouseWheel="FeedScroll_PreviewMouseWheel">
                    <ItemsControl x:Name="FeedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CardBrush}"
                                        BorderBrush="{Binding BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="FeedItem_Click"
                                        Padding="14,12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="12"
                                                Background="{Binding AvatarBrush}"
                                                VerticalAlignment="Top" ClipToBounds="True">
                                            <TextBlock Text="{Binding Initial}" Foreground="White"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Author}" FontSize="16"
                                                           FontWeight="SemiBold" Foreground="#111111" />
                                                <TextBlock Text="{Binding Time}" FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="#222222" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <TextBlock FontSize="16"
                                                       Foreground="#111111" TextWrapping="Wrap"
                                                       LineHeight="23"
                                                       Margin="0,6,0,0"
                                                       Loaded="RichText_Loaded" />
                                            <Border CornerRadius="10" ClipToBounds="True"
                                                    HorizontalAlignment="Left" MaxWidth="520"
                                                    Margin="0,8,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasImage}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Image Source="{Binding ImageSource}"
                                                       Stretch="Uniform"
                                                       MaxHeight="260"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</ui:Page>
