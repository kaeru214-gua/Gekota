<Window x:Class="Gekota.WPF.Controls.AppearanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="自定义外观" Width="470" Height="540"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="主题色（仅应用于侧边栏与上方文件栏）" FontSize="14" FontWeight="Bold"/>
        <WrapPanel x:Name="ColorPanel" Grid.Row="1" Margin="0,8,0,0"/>

        <TextBlock Grid.Row="2" Text="页面背景图" FontSize="14" FontWeight="Bold" Margin="0,16,0,0"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="上传图片" Click="PickImage_Click" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="清除背景" Click="ClearImage_Click" Padding="12,4"/>
            <TextBlock x:Name="ImagePathText" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="#888888" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="白色遮罩不透明度（最低 25%）" FontSize="14" FontWeight="Bold" Margin="0,16,0,0"/>
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="MaskSlider" Minimum="0.25" Maximum="1" SmallChange="0.05"
                    LargeChange="0.1" ValueChanged="MaskSlider_ValueChanged"/>
            <TextBlock x:Name="MaskValueText" Grid.Column="1" VerticalAlignment="Center"
                       Margin="10,0,0,0" MinWidth="48" TextAlignment="Right"/>
        </Grid>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="关闭" Click="Close_Click" Padding="16,5"/>
        </StackPanel>
    </Grid>
</Window>
