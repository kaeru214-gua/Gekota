<ui:Page
    x:Class="Gekota.WPF.Pages.UserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:l="https://github.com/XAMLMarkupExtensions/WPFLocalizationExtension"
    l:LocalizeDictionary.DesignCulture=""
    l:ResxLocalizationProvider.DefaultAssembly="Gekota.WPF"
    l:ResxLocalizationProvider.DefaultDictionary="Strings"
    xmlns:local="clr-namespace:Gekota.WPF.Pages"
    mc:Ignorable="d"
    d:DesignHeight="600" d:DesignWidth="900"
    Title="UserPage">
    <Grid Margin="20">

        <!-- ==================== 未登录 ==================== -->
        <Grid x:Name="NotLoggedInPanel">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="哔哩哔哩扫码登录" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="打开哔哩哔哩手机客户端，扫描下方二维码" FontSize="14" Foreground="#888888"
                           HorizontalAlignment="Center" Margin="0,8,0,20"/>

                <Border BorderBrush="{DynamicResource SystemControlBackgroundAccentBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10"
                        HorizontalAlignment="Center" Background="White">
                    <Grid Width="240" Height="240">
                        <Image x:Name="QrImage" Stretch="Uniform"/>
                        <ui:ProgressRing x:Name="QrLoading" IsActive="True" Width="60" Height="60"/>
                        <StackPanel x:Name="QrExpiredOverlay" Visibility="Collapsed"
                                    Background="White" Width="240" Height="240">
                            <TextBlock Text="二维码已失效" FontSize="16" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Margin="0,80,0,10"/>
                            <Button Content="点击刷新" HorizontalAlignment="Center" Click="RefreshQr_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="QrStatusText" Text="正在加载二维码..." HorizontalAlignment="Center"
                           FontSize="14" Foreground="#666666" Margin="0,15,0,0"/>
                <Button Content="刷新二维码" HorizontalAlignment="Center" Margin="0,15,0,0" Click="RefreshQr_Click"/>
            </StackPanel>
        </Grid>

        <!-- ==================== 已登录 ==================== -->
        <Grid x:Name="LoggedInPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 头像：圆形裁剪，无外框 -->
                <Border Width="64" Height="64" Background="Transparent">
                    <Image x:Name="AvatarImage" Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/>
                        </Image.Clip>
                    </Image>
                </Border>

                <!-- 昵称 + bid：两行等宽 -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="200">
                    <TextBlock x:Name="UsernameText" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="UidText" FontSize="12" Foreground="#888888" Margin="0,2,0,0"
                               HorizontalAlignment="Stretch" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 退出登录：靠右 + 垂直居中 -->
                <Button Grid.Column="2" Content="退出登录"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Logout_Click"/>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,0" x:Name="UploadPanel"
                    BorderBrush="{DynamicResource SystemControlBackgroundAccentBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="B站上传" FontSize="18" FontWeight="Bold"/>
                        <CheckBox x:Name="AutoUploadBox" Content="自动上传（压制完成后自动投稿）" Margin="0,12,0,0"
                                  Checked="AutoUploadBox_Changed" Unchecked="AutoUploadBox_Changed"/>

                        <!-- 自动上传进度与提醒 -->
                        <Border x:Name="AutoUploadStatusPanel" Visibility="Collapsed" Margin="0,10,0,0"
                                BorderBrush="{DynamicResource SystemControlBackgroundAccentBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="自动上传状态" FontWeight="Bold"/>
                                <TextBlock x:Name="AutoUploadTitleText" Margin="0,6,0,0"
                                           Foreground="#888888" TextTrimming="CharacterEllipsis" Text="（等待录播结束）"/>
                                <TextBlock x:Name="AutoUploadStageText" Margin="0,4,0,0" Text="空闲"/>
                                <ProgressBar x:Name="AutoUploadProgress" Height="6" Margin="0,6,0,0"
                                             Minimum="0" Maximum="100" Value="0"/>
                                <TextBlock x:Name="AutoUploadResultText" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <Button Content="清除" HorizontalAlignment="Left" Margin="0,8,0,0" Click="ClearUploadStatus_Click"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="ManualPanel" Margin="0,8,0,0">
    <Button Content="选择录播文件（.flv / .mp4）" HorizontalAlignment="Left" Click="PickRecording_Click"/>
    <TextBlock x:Name="PickedFileText" Foreground="#888888" TextWrapping="Wrap" Margin="0,4,0,0"/>
    <TextBlock FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,2,0,0"
               Text="选择文件用于定位录制目录；实际上传同目录【纯净版】/【弹幕版】及主播目录【防撞】。"/>

    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <Border Width="120" Height="75" Background="#22000000" BorderBrush="#44000000" BorderThickness="1">
                <Image x:Name="CoverPreview" Stretch="UniformToFill"/>
            </Border>
            <Button Content="选择封面" HorizontalAlignment="Left" Margin="0,6,0,0" Click="PickCover_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged"/>
                <TextBlock x:Name="TitleCountText" Grid.Column="1" VerticalAlignment="Bottom"
                           Foreground="#888888" Margin="4,0,0,2" Text="0/80"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="分区" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="TidComboBox" Grid.Column="1" HorizontalAlignment="Left" MinWidth="170"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="标签" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TagsBox" Grid.Column="1"/>
            </Grid>
        </StackPanel>
    </Grid>

    <TextBlock Text="简介" Margin="0,10,0,2"/>
    <TextBox x:Name="DescBox" AcceptsReturn="True" TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto"/>

    <TextBlock Text="更多设置" Margin="0,10,0,2"/>
    <StackPanel Margin="0,2,0,0">
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="CopyrightZhuanzaiRadio" Content="转载" GroupName="Copyright" IsChecked="True" Checked="Copyright_Changed"/>
            <RadioButton x:Name="CopyrightZizhiRadio" Content="自制" GroupName="Copyright" Margin="8,0,0,0" Checked="Copyright_Changed"/>
        </StackPanel>
        <StackPanel x:Name="SourcePanel" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="来源" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="SourceBox" Width="280"/>
        </StackPanel>
        <WrapPanel Margin="0,8,0,0">
            <CheckBox x:Name="NoReprintCheckBox" Content="禁止转载" Margin="0,0,12,0" IsChecked="True"/>
            <CheckBox x:Name="CloseDanmuCheckBox" Content="关闭弹幕" Margin="0,0,12,0"/>
            <CheckBox x:Name="CloseReplyCheckBox" Content="关闭评论" Margin="0,0,12,0"/>
        </WrapPanel>
    </StackPanel>

    <TextBlock Text="将上传的文件" Margin="0,10,0,2"/>
    <TextBlock x:Name="UploadFilesText" FontFamily="Consolas" TextWrapping="Wrap" Foreground="#888888" Text="（未选择文件）"/>

    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="保存标签预设" Click="SaveTags_Click" Margin="0,0,8,0"/>
        <Button Content="立即投稿" Click="ManualUpload_Click"/>
    </StackPanel>
</StackPanel>

                        <TextBlock x:Name="UploadStatusText" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="UploadProgress" Height="6" Margin="0,6,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</ui:Page>
