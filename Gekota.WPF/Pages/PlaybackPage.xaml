<ui:Page
    x:Class="Gekota.WPF.Pages.PlaybackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:Gekota.WPF.Pages"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    mc:Ignorable="d"
    x:Name="ThePlaybackPage"
    d:DesignHeight="800" d:DesignWidth="1100"
    DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=local:RootPage},Path=DataContext.Recorder,Mode=OneWay}">
    <Border Background="Transparent" ClipToBounds="True">
        <Grid>
            <wv2:WebView2 x:Name="LiveWebView"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Visibility="Collapsed"
                          DefaultBackgroundColor="Transparent" />
            <TextBlock x:Name="StatusOverlay"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="#CCFFFFFF" FontSize="14" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="24" IsHitTestVisible="False"
                       Text="正在连接直播流…"/>
        </Grid>
    </Border>
</ui:Page>
