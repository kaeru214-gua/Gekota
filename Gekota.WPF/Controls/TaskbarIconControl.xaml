<UserControl
    x:Class="Gekota.WPF.Controls.TaskbarIconControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:l="https://github.com/XAMLMarkupExtensions/WPFLocalizationExtension"
    l:LocalizeDictionary.DesignCulture=""
    l:ResxLocalizationProvider.DefaultAssembly="Gekota.WPF"
    l:ResxLocalizationProvider.DefaultDictionary="Strings"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    xmlns:local="clr-namespace:Gekota.WPF.Controls"
    xmlns:core="clr-namespace:Gekota.Core;assembly=Gekota.Core"
    mc:Ignorable="d">
    <tb:TaskbarIcon 
        x:Name="TaskbarIcon" TrayLeftMouseUp="TaskbarIcon_TrayLeftMouseUp"
        Visibility="{Binding Recorder, Converter={StaticResource IsNullToVisibilityCollapsedConverter}}"
        ToolTipText="{l:Loc TaskbarIconControl_Title}" MenuActivation="RightClick"
        >
        <tb:TaskbarIcon.ContextMenu>
            <ContextMenu l:ResxLocalizationProvider.DefaultDictionary="Strings">
                <MenuItem Header="{l:Loc TaskbarIconControl_MenuItem_OpenMainWindow}" Click="MenuItem_OpenMainWindow_Click"/>
                <Separator/>
                <MenuItem Header="{l:Loc Global_Quit}" Click="MenuItem_Quit_Click"/>
            </ContextMenu>
        </tb:TaskbarIcon.ContextMenu>
        <tb:TaskbarIcon.TrayToolTip>
            <ToolTip Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     HasDropShadow="False">
                <ToolTip.Template>
                    <ControlTemplate TargetType="ToolTip">
                        <ContentPresenter />
                    </ControlTemplate>
                </ToolTip.Template>
            <Border
                Background="{DynamicResource MacCardBrush}"
                BorderBrush="#24000000"
                MinWidth="280"
                BorderThickness="1"
                CornerRadius="14"
                Padding="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="12,10,12,8">
                        <TextBlock Text="Gekota" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MacTextPrimaryBrush}" FontFamily="{DynamicResource MacFontFamily}"/>
                        <TextBlock Text="{Binding Recorder.Config.Global.WorkDirectory, Mode=OneWay}"
                                   Foreground="{DynamicResource MacTextTertiaryBrush}" FontSize="11" TextWrapping="NoWrap"
                                   FontFamily="{DynamicResource MacFontFamily}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Separator Grid.Row="1" Background="{DynamicResource MacSeparatorBrush}" />
                    <ItemsControl Grid.Row="2" Margin="12,8,12,10"
                                  ItemsSource="{Binding Recorder.Rooms, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:IRoom}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                    <ui:PathIcon Width="14" Style="{StaticResource PathIconDataAccessPoint}"
                                                 Foreground="{Binding Streaming,Converter={StaticResource BooleanToLiveStatusColorBrushConverter}}"/>
                                    <ui:PathIcon
                                        Visibility="{Binding RoomConfig.AutoRecord,Converter={StaticResource BooleanToVisibilityHiddenConverter}}"
                                        Style="{StaticResource PathIconDataCctv}" Foreground="DarkOrange"
                                        Width="14" Margin="4,0,0,0"/>
                                    <ui:PathIcon
                                        Visibility="{Binding Recording,Converter={StaticResource BooleanToVisibilityHiddenConverter}}"
                                        Style="{StaticResource PathIconDataRecordRec}" Foreground="#E5484D"
                                        Width="14" Margin="4,0"/>
                                    <TextBlock Text="{Binding Name, Mode=OneWay}" TextWrapping="NoWrap"
                                               Foreground="{DynamicResource MacTextPrimaryBrush}" FontSize="12"
                                               FontFamily="{DynamicResource MacFontFamily}" TextTrimming="CharacterEllipsis"
                                               MaxWidth="190" VerticalAlignment="Center"/>
                                    <Border VerticalAlignment="Center" MinWidth="82"
                                            Visibility="{Binding Recording,Converter={StaticResource BooleanToVisibilityHiddenConverter}}"
                                            Background="{Binding Stats.DurationRatio, Converter={StaticResource RatioToColorBrushConverter},Mode=OneWay}"
                                            BorderThickness="1" BorderBrush="#30000000"
                                            Margin="6,0,0,0" CornerRadius="6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="4,0">
                                            <ui:PathIcon MaxWidth="10" Foreground="{DynamicResource MacTextPrimaryBrush}"
                                                         Style="{Binding Stats.DurationRatio, Converter={StaticResource RatioToArrowIconConverter}}"/>
                                            <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource MacTextPrimaryBrush}"
                                                       FontSize="11" FontFamily="{DynamicResource MacFontFamily}" Margin="2,0,0,0">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{l:StringFormatConverter}">
                                                        <l:BLoc Key="RoomCard_Status_SpeedIndicator_SpeedInMbps"/>
                                                        <Binding Path="Stats.NetworkMbps" Mode="OneWay"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            </ToolTip>
        </tb:TaskbarIcon.TrayToolTip>
    </tb:TaskbarIcon>
</UserControl>
