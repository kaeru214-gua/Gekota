<UserControl
    x:Class="Gekota.WPF.Controls.AddRoomCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:l="https://github.com/XAMLMarkupExtensions/WPFLocalizationExtension"
    l:LocalizeDictionary.DesignCulture=""
    l:ResxLocalizationProvider.DefaultAssembly="Gekota.WPF"
    l:ResxLocalizationProvider.DefaultDictionary="Strings"
    xmlns:local="clr-namespace:Gekota.WPF.Controls"
    mc:Ignorable="d" 
    d:DesignHeight="110" d:DesignWidth="210">
    <Border Background="#40FFFFFF"
            BorderThickness="0"
            CornerRadius="5">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3.5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 标题：白色 + 投影，保证在任何背景图上都清晰 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.ColumnSpan="2">
                <ui:PathIcon Margin="5" Foreground="White" Style="{StaticResource PathIconDataPlus}"/>
                <TextBlock FontSize="20" VerticalAlignment="Center" Foreground="White"
                           Text="{l:Loc AddRoomCard_Title}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.85"/>
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <!-- 输入框：半透明黑底 + 白字 + 浅色占位符 -->
            <TextBox Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" x:Name="InputTextBox"
                     ui:TextBoxHelper.IsDeleteButtonVisible="False"
                     FontSize="{l:Loc AddRoomCard_PlaceholderText_FontSize}"
                     ui:ControlHelper.PlaceholderText="{l:Loc AddRoomCard_PlaceholderText}"
                     Background="#33000000" Foreground="White" BorderBrush="#33000000" CaretBrush="White"
                     KeyDown="InputTextBox_KeyDown">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#B3FFFFFF"/>
                </TextBox.Resources>
            </TextBox>

            <!-- 确认按钮：半透明黑底 + 白字（与外观按钮一致） -->
            <Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                    Content="{l:Loc AddRoomCard_ConfirmButton}" Click="Button_Click"
                    Background="#9923ADE5" Foreground="White" BorderBrush="#6623ADE5"/>
        </Grid>
    </Border>
</UserControl>
