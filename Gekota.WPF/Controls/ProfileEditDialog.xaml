<Window x:Class="Gekota.WPF.Controls.ProfileEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource MacCardBrush}"
            BorderBrush="{DynamicResource MacBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="24,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                       FontFamily="{DynamicResource MacFontFamily}" Foreground="{DynamicResource MacTextPrimaryBrush}"/>
            <TextBlock x:Name="HintText" Margin="0,6,0,0" FontSize="12"
                       FontFamily="{DynamicResource MacFontFamily}" Foreground="{DynamicResource MacTextTertiaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBox x:Name="Editor" Margin="0,14,0,0"
                     MinHeight="96" MaxHeight="260"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="10,8"
                     FontFamily="{DynamicResource MacFontFamily}" FontSize="13"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="86" Height="32" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="保存" Width="86" Height="32" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
