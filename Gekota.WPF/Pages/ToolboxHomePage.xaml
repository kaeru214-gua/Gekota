<ui:Page
    x:Class="Gekota.WPF.Pages.ToolboxHomePage"
    x:Name="ToolboxHomeRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    mc:Ignorable="d"
    d:DesignHeight="760" d:DesignWidth="1000"
    Background="Transparent"
    Title="ToolboxHomePage"
>

    <ui:Page.Resources>
        <Style x:Key="ToolboxCardStyle" TargetType="Border">
            <EventSetter Event="MouseLeftButtonUp" Handler="ToolCard_MouseLeftButtonUp" />
            <Setter Property="Background" Value="{DynamicResource MacCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MacBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MacControlHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource MacStrongBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolGlyphTileStyle" TargetType="Border">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource MacAccentSoftBrush}" />
        </Style>
    </ui:Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,22,32,32">
            <TextBlock Text="工具箱" Style="{StaticResource MacTitleTextStyle}" />
            <TextBlock Text="录播修复、弹幕处理、压制与转封装。选一个开始。"
                       Style="{StaticResource MacSubheadTextStyle}"
                       Margin="0,6,0,22" TextWrapping="Wrap" />

            <UniformGrid Columns="2" Margin="0,0,-14,0">
                <Border Style="{StaticResource ToolboxCardStyle}" Tag="ToolboxAutoFixPage">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ToolGlyphTileStyle}">
                            <ui:PathIcon Width="23" Height="23"
                                         Foreground="{DynamicResource MacAccentBrush}"
                                         Style="{StaticResource PathIconDataAutoFix}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="录播修复" Style="{StaticResource MacHeadlineTextStyle}" />
                            <TextBlock Text="检测并修复损坏的录播文件"
                                       Style="{StaticResource MacCaptionTextStyle}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:PathIcon Grid.Column="2" Width="8" Height="13"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource MacTextTertiaryBrush}"
                                     Data="M 0,0 L 6,6.5 L 0,13 Z" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToolboxCardStyle}" Tag="ToolboxDanmakuMergerPage">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ToolGlyphTileStyle}">
                            <ui:PathIcon Width="23" Height="23"
                                         Foreground="{DynamicResource MacAccentBrush}"
                                         Style="{StaticResource PathIconDataMerge}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="弹幕合并" Style="{StaticResource MacHeadlineTextStyle}" />
                            <TextBlock Text="把多段录播的弹幕拼接到一起"
                                       Style="{StaticResource MacCaptionTextStyle}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:PathIcon Grid.Column="2" Width="8" Height="13"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource MacTextTertiaryBrush}"
                                     Data="M 0,0 L 6,6.5 L 0,13 Z" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToolboxCardStyle}" Tag="ToolboxDanmakuConvertPage">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ToolGlyphTileStyle}">
                            <ui:PathIcon Width="23" Height="23"
                                         Foreground="{DynamicResource MacAccentBrush}"
                                         Style="{StaticResource PathIconDataSubtitle}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="弹幕转换" Style="{StaticResource MacHeadlineTextStyle}" />
                            <TextBlock Text="XML 转 ASS，调整样式与分辨率"
                                       Style="{StaticResource MacCaptionTextStyle}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:PathIcon Grid.Column="2" Width="8" Height="13"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource MacTextTertiaryBrush}"
                                     Data="M 0,0 L 6,6.5 L 0,13 Z" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToolboxCardStyle}" Tag="ToolboxCompressPage">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ToolGlyphTileStyle}">
                            <ui:PathIcon Width="23" Height="23"
                                         Foreground="{DynamicResource MacAccentBrush}"
                                         Style="{StaticResource PathIconDataPlayCircleOutline}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="视频压制" Style="{StaticResource MacHeadlineTextStyle}" />
                            <TextBlock Text="压缩体积，可同时烧录弹幕"
                                       Style="{StaticResource MacCaptionTextStyle}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:PathIcon Grid.Column="2" Width="8" Height="13"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource MacTextTertiaryBrush}"
                                     Data="M 0,0 L 6,6.5 L 0,13 Z" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ToolboxCardStyle}" Tag="ToolboxRemuxPage">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ToolGlyphTileStyle}">
                            <ui:PathIcon Width="23" Height="23"
                                         Foreground="{DynamicResource MacAccentBrush}"
                                         Style="{StaticResource PathIconDataAlphaRCircleOutline}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="转封装" Style="{StaticResource MacHeadlineTextStyle}" />
                            <TextBlock Text="FLV 无损转换为 MP4"
                                       Style="{StaticResource MacCaptionTextStyle}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:PathIcon Grid.Column="2" Width="8" Height="13"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource MacTextTertiaryBrush}"
                                     Data="M 0,0 L 6,6.5 L 0,13 Z" />
                    </Grid>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</ui:Page>
