<ui:Page
    x:Class="Gekota.WPF.Pages.AnnouncementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    mc:Ignorable="d"
    d:DesignHeight="900" d:DesignWidth="820"
    Title="AnnouncementPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="声明" FontSize="30" FontWeight="Bold" FontFamily="Microsoft YaHei"/>

            <Border Background="#140078D4" BorderBrush="#330078D4" BorderThickness="1"
                    CornerRadius="10" Padding="9,3" HorizontalAlignment="Left" Margin="0,8,0,0">
                <TextBlock x:Name="VersionText" Text="v1.2.2" FontSize="12" FontWeight="Bold"
                           FontFamily="Microsoft YaHei" Foreground="#FF0B5FA5"/>
            </Border>

            <TextBlock Margin="0,14,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                       Foreground="#666870" TextWrapping="Wrap"
                       Text="Gekota 是一个免费、开源的哔哩哔哩录播工具。使用前请阅读以下声明。"/>

            <Button Content="打开使用教程" HorizontalAlignment="Left" Margin="0,12,0,0"
                    Padding="16,7" Click="Tutorial_Click"/>

            <!-- 软件声明 -->
            <Border Background="#0D0078D4" BorderBrush="#220078D4" BorderThickness="1"
                    CornerRadius="14" Padding="18,16" Margin="0,22,0,0">
                <StackPanel>
                    <TextBlock Text="软件声明" FontSize="18" FontWeight="Bold" FontFamily="Microsoft YaHei"/>
                    <TextBlock Margin="0,10,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="本软件为免费软件，仅供学习交流使用，禁止用于任何商业用途。"/>
                    <TextBlock Margin="0,6,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="录制、压制和上传的内容版权归原主播及权利方所有。使用者应遵守哔哩哔哩平台规则及相关法律法规，不得传播违法、侵权或未经授权的内容。"/>
                    <TextBlock Margin="0,6,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="使用本软件产生的任何后果由使用者自行承担。"/>
                </StackPanel>
            </Border>

            <!-- 数据来源 -->
            <Border Background="#0D000000" BorderBrush="#18000000" BorderThickness="1"
                    CornerRadius="14" Padding="18,16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="数据来源" FontSize="18" FontWeight="Bold" FontFamily="Microsoft YaHei"/>
                    <TextBlock Margin="0,10,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="日程表数据来自哔哩哔哩动态、直播预约、微博公开动态，以及用户自行导入的日历链接。"/>
                    <TextBlock Margin="0,6,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="A-SOUL / 闪耀舞台日程来自闪耀舞台公开日历；本软件与哔哩哔哩、微博及日历提供方均无隶属关系。"/>
                </StackPanel>
            </Border>

            <!-- 开源与致谢 -->
            <Border Background="#0D000000" BorderBrush="#18000000" BorderThickness="1"
                    CornerRadius="14" Padding="18,16" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="开源与致谢" FontSize="18" FontWeight="Bold" FontFamily="Microsoft YaHei"/>
                    <TextBlock Margin="0,10,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="本项目基于 BililiveRecorder（录播姬）修改而来，遵循 GNU General Public License v3.0 协议开源。"/>
                    <TextBlock Margin="0,4,0,0" FontSize="13" FontFamily="Microsoft YaHei"
                               Foreground="#7A7C84" Text="原始版权：Copyright © 2018-2026 Genteure"/>
                    <TextBlock Margin="0,2,0,0" FontSize="13" FontFamily="Microsoft YaHei"
                               Foreground="#7A7C84" Text="修改部分版权：Copyright © 2026 Gekota Contributors"/>

                    <TextBlock Margin="0,14,0,0" FontSize="14" FontWeight="Bold" FontFamily="Microsoft YaHei"
                               Text="特别鸣谢"/>
                    <TextBlock Margin="0,8,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="· BililiveRecorder：录制核心与开源基础"/>
                    <TextBlock Margin="0,5,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="· DanmakuFactory：弹幕转换"/>
                    <TextBlock Margin="0,5,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="· ShanaEncoder：视频压制"/>
                    <TextBlock Margin="0,5,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="· biliup / biliup-rs：自动上传"/>
                    <TextBlock Margin="0,5,0,0" FontSize="14" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#4C4E57"
                               Text="· 枝江日程表：A-SOUL / 闪耀舞台日历数据"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="枝江日程表：" FontSize="13" FontFamily="Microsoft YaHei"
                                   Foreground="#666870" VerticalAlignment="Center"/>
                        <ui:HyperlinkButton Padding="0" FontFamily="Microsoft YaHei"
                                            Content="https://asoul.love/calendar"
                                            NavigateUri="https://asoul.love/calendar"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="原始项目：" FontSize="13" FontFamily="Microsoft YaHei"
                                   Foreground="#666870" VerticalAlignment="Center"/>
                        <ui:HyperlinkButton Padding="0" FontFamily="Microsoft YaHei"
                                            Content="https://github.com/BililiveRecorder/BililiveRecorder"
                                            NavigateUri="https://github.com/BililiveRecorder/BililiveRecorder"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 联系方式 -->
            <Border Background="#0D000000" BorderBrush="#18000000" BorderThickness="1"
                    CornerRadius="14" Padding="18,16" Margin="0,14,0,24">
                <StackPanel>
                    <TextBlock Text="联系方式" FontSize="18" FontWeight="Bold" FontFamily="Microsoft YaHei"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="哔哩哔哩：" FontSize="14" FontFamily="Microsoft YaHei"
                                   Foreground="#666870" VerticalAlignment="Center"/>
                        <ui:HyperlinkButton Padding="0" FontFamily="Microsoft YaHei"
                                            Content="gua_02014"
                                            NavigateUri="https://space.bilibili.com/26187233"/>
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" FontSize="13" FontFamily="Microsoft YaHei"
                               TextWrapping="Wrap" Foreground="#888A92"
                               Text="如有问题，请在项目仓库提交 Issue。"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</ui:Page>
