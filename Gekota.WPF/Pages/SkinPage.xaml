<ui:Page
    x:Class="Gekota.WPF.Pages.SkinPage"
    x:Name="SkinPageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    mc:Ignorable="d"
    d:DesignHeight="900" d:DesignWidth="1000"
    Background="Transparent"
    Title="SkinPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,22,32,36" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="外观" Style="{StaticResource MacTitleTextStyle}" />
            <TextBlock Text="调整颜色模式、窗口材质和页面背景。"
                       Style="{StaticResource MacSubheadTextStyle}"
                       Margin="0,6,0,22" TextWrapping="Wrap" />

            <!-- 颜色模式 -->
            <Border Background="{DynamicResource MacCardBrush}"
                    BorderBrush="{DynamicResource MacBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="21"
                    Padding="22,18"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="颜色模式" Style="{StaticResource MacHeadlineTextStyle}" />
                        <TextBlock Text="切换浅色或深色外观，选择会自动保存。"
                                   Style="{StaticResource MacCaptionTextStyle}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="580" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     x:Name="DarkModeSwitch"
                                     VerticalAlignment="Center"
                                     Margin="18,0,0,0"
                                     Style="{StaticResource MacToggleSwitchStyle}"
                                     OnContent="深色"
                                     OffContent="浅色"
                                     Toggled="DarkModeSwitch_Toggled" />
                </Grid>
            </Border>

            <!-- 窗口材质 -->
            <Border Background="{DynamicResource MacCardBrush}"
                    BorderBrush="{DynamicResource MacBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="21"
                    Padding="22,18"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="窗口材质" Style="{StaticResource MacHeadlineTextStyle}" />
                        <TextBlock Text="开启后背景图进行磨砂模糊，卡片和 Dock 更通透；没有背景图时使用 Windows 原生亚克力。关闭后使用清晰背景和更实的卡片。"
                                   Style="{StaticResource MacCaptionTextStyle}"
                                   Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="580" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     x:Name="AcrylicSwitch"
                                     VerticalAlignment="Center"
                                     Margin="18,0,0,0"
                                     Style="{StaticResource MacToggleSwitchStyle}"
                                     OnContent="亚克力"
                                     OffContent="纯色"
                                     Toggled="AcrylicSwitch_Toggled" />
                </Grid>
            </Border>

            <!-- 页面背景 -->
            <Border Background="{DynamicResource MacCardBrush}"
                    BorderBrush="{DynamicResource MacBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="21"
                    Padding="22,18"
                    Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="页面背景" Style="{StaticResource MacHeadlineTextStyle}" />
                    <TextBlock Text="选一张图片作为窗口背景，直接叠加磨砂玻璃内容。"
                               Style="{StaticResource MacCaptionTextStyle}"
                               Margin="0,3,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                        <Button Content="选择图片…" Style="{StaticResource MacAccentButtonStyle}" Click="PickImage_Click" />
                        <Button Content="移除背景" Margin="8,0,0,0" Style="{StaticResource MacQuietButtonStyle}" Click="ClearImage_Click" />
                        <TextBlock x:Name="ImagePathText"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   MaxWidth="300"
                                   TextTrimming="CharacterEllipsis"
                                   Style="{StaticResource MacCaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="提示：右键点击主页面空白处可以打开功能菜单；Dock 图标可在左侧导航。"
                       Style="{StaticResource MacCaptionTextStyle}"
                       Margin="4,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</ui:Page>
