<Window x:Class="Gekota.WPF.Controls.TutorialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用教程"
        Width="760" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="TutorialHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,20,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource MacTextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource MacFontFamily}" />
        </Style>
        <Style x:Key="TutorialText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="21" />
            <Setter Property="Foreground" Value="{DynamicResource MacTextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource MacFontFamily}" />
        </Style>
        <Style x:Key="TutorialCode" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource MacTextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource MacMonoFontFamily}" />
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource MacCardBrush}"
            BorderBrush="{DynamicResource MacBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="26,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="7" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Gekota 使用教程" FontSize="24" FontWeight="Bold"
                           FontFamily="{DynamicResource MacFontFamily}"
                           Foreground="{DynamicResource MacTextPrimaryBrush}"/>
                <TextBlock Text="第一次使用建议按下面顺序操作。" Margin="0,6,0,0"
                           FontSize="13" FontFamily="{DynamicResource MacFontFamily}"
                           Foreground="{DynamicResource MacTextTertiaryBrush}"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,8,0,12" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="1. 登录与添加直播间" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="在「用户」页面扫码登录哔哩哔哩。回到首页点击「添加房间」，输入房间号或直播间链接后确定。首页卡片右侧三个点可以打开直播间、修改单房间设置、设置标签和编辑简介。标签写入主播文件夹的 tag.txt，简介写入 简介.txt，自动上传时会读取。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="2. 播放模式与录制模式" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="设置 → 通用 → 模式里有两个互斥模式：播放模式默认开启，只观看、不自动录制；录制模式开启后自动录制，并显示完整录制设置。开启录制模式时播放模式开关会隐藏，关闭录制模式后回到播放模式。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="3. 保存素材" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="设置 → 录制模式 → 保存素材，默认关闭。开启后选择保存文件夹，每次录制转封装完成后只保存 MP4 和 ASS，不保存 FLV、XML、压缩产物或防撞文件。目录结构：" />
                    <Border Background="{DynamicResource MacFieldBrush}" CornerRadius="7" Padding="10,7" Margin="0,5,0,0">
                        <TextBlock Style="{StaticResource TutorialCode}"
                                   Text="素材路径\主播-直播场次\视频.mp4&#10;素材路径\主播-直播场次\弹幕.ass" />
                    </Border>
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="如果没有生成 ASS，保存素材前会自动转换一次。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="4. 首页与监控室" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="首页卡片显示主播、标题、直播状态、录制状态和网速。监控室最多同时显示 9 个直播间，左侧优先显示正在直播的房间，直播房间使用 2×2 网格，未开播房间在右侧单列排列。每个房间可以单独静音，点击进入播放页。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="5. 播放器与弹幕" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="播放页支持音量、静音、画质、飞屏弹幕、弹幕不重合、特殊弹幕、自动滚动和发送弹幕。音量和弹幕设置会自动记住。SC 不参与普通飞屏，可以在弹幕设置里选择左下角或右下角，并调整 20% 到 100% 的透明度。多个 SC 会纵向堆叠，按自己的保留时长消失。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="6. 录制、分段与合并" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="开启录制模式后，主播开播会自动录制。支持标题变化分段、按大小分段、按时长分段。断流或重连产生的多个 FLV 会自动合并，合并时重新生成 XML 和 ASS。合并结果校验通过后会删除旧的未合并视频和弹幕；校验失败会保留原文件。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="启动时也会检测最近未清理的分段并补合并，合并后继续执行转封装、压制和上传。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="7. 视频压制与中断恢复" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="工具箱 → 视频压制可以压制纯净版和弹幕版，支持暂停、继续和强制停止。如果 Gekota 意外关闭或压制中断，未完成任务会保存，下次打开后自动读取并显示在视频压制页面，继续压制。正在写入的录制文件不会提前压制。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="只有输出文件存在且能正常解析才会被视为完成，半成品会重新压制。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="8. 自动上传" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="设置 → 录制结束后自动化 → 自动上传 B 站。标题模板默认 {title}，支持 {streamer}、{date}、{time}、{roomId}。简介和标签读取主播文件夹的 简介.txt 和 tag.txt，标签用分号分隔。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="A-SOUL、双播、心宜思诺会自动替换标题中的主播名，合并对应成员的简介和标签并去重。没有当前主播防撞文件时会跳过自动上传。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="纯净版或弹幕版超过 16GB 时会按时间拆分为分 P，名称为 纯净版Part1、纯净版Part2、弹幕版Part1、弹幕版Part2。自动投稿成功后删除该场次直播文件夹；房间仍在录制或当前文件仍在该目录时不会删除。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="启动时会扫描本地已经生成纯净版/弹幕版但未成功投稿的录播，检查防撞、登录和上传历史后自动补投稿。压制恢复完成后也会再扫描一次。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="9. 日程表" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="普通主播的日程来自 B 站动态、B 站直播预约和微博公开动态。" />
                    <Border Background="#140078D4" BorderBrush="#330078D4" BorderThickness="1"
                            CornerRadius="10" Padding="12,10" Margin="0,7,0,0">
                        <StackPanel>
                            <TextBlock Text="A-SOUL / 闪耀舞台" FontWeight="Bold" FontSize="14"
                                       Foreground="#0B5FA5" FontFamily="{DynamicResource MacFontFamily}" />
                            <TextBlock Style="{StaticResource TutorialText}" Margin="0,4,0,0" FontSize="12"
                                       Text="只有 A-SOUL 和闪耀舞台使用 ICS 日历。推荐通过枝江日程表获取日历链接：" />
                            <TextBlock Style="{StaticResource TutorialCode}" Margin="0,3,0,0" Foreground="#0B5FA5"
                                       Text="https://asoul.love/calendar" />
                            <TextBlock Style="{StaticResource TutorialText}" Margin="0,4,0,0" FontSize="12"
                                       Text="在日程页粘贴 ICS 链接并点击「导入」。未添加 A-SOUL / 闪耀舞台成员时不会显示导入提示。" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,7,0,0"
                               Text="ICS 会使用本地缓存：30 分钟内不重复请求，之后带 ETag / Last-Modified 条件请求；内容没变继续用缓存，变化才替换，网络失败时回退缓存。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="新场次自动加入；已取消场次显示「已取消」；已结束以直播间结束为准，不按日程时间直接判断。团体日程会检查对应成员房间。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="日程卡片可以点击「跳过」。跳过会保存到本地，重启后继续生效，团体日程会匹配对应成员，时间前后 90 分钟内有效；如果正在录制会停止对应房间。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="10. 动态页" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="「动态」页面集中浏览已添加主播的 B 站动态，支持按主播筛选、图片查看和定时刷新。删除主播后主播栏会自动更新。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="11. 工具箱" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="工具箱包含录播修复、弹幕合并、弹幕转换、视频压制和转封装。弹幕转换设置可以直接保存，不需要先转换文件。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="12. 设置、外观与退出" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="设置侧栏包含通用、外观、声明、日志和关于。外观里可以切换浅色/深色、开关亚克力、选择或移除页面背景，这些设置会保存。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="关闭 Gekota 时会结束 ShanaEncoder 压制进程，下次启动会清理遗留进程。如果启用了关闭到托盘，点击关闭只会隐藏窗口，压制会继续；真正退出请使用托盘菜单的退出。" />

                    <TextBlock Style="{StaticResource TutorialHeading}" Text="13. 常见问题" />
                    <TextBlock Style="{StaticResource TutorialText}"
                               Text="自动上传没有开始：检查自动上传开关、登录状态、当前主播防撞文件、纯净版/弹幕版是否生成，以及上传状态或日志里的跳过原因。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="压制进度不动：检查是否暂停、是否有多个 ShanaEncoder 进程、GPU/NVENC 是否被占用；退出并重新打开 Gekota，让启动清理逻辑处理遗留进程。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="日程没有更新：检查 ICS 链接和刷新按钮；缓存期间不会重复下载；只有 ICS 内容变化才替换缓存。" />
                    <TextBlock Style="{StaticResource TutorialText}" Margin="0,5,0,0"
                               Text="删除主播后日程还在：日程页会自动刷新；团体日程只在至少还有对应成员时显示。" />

                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="开始使用" Width="110" Height="34"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
