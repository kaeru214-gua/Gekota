<ui:Page
    x:Class="Gekota.WPF.Pages.ToolboxCompressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    mc:Ignorable="d"
    DataContext="{x:Null}"
    d:DesignHeight="760" d:DesignWidth="1100"
    Title="ToolboxCompressPage">
    <Grid>
        <!-- ================= 视图一：文件列表 ================= -->
        <Grid x:Name="ListView">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 文件列表（列宽铺满） -->
            <DataGrid x:Name="FileList" Grid.Row="0" Margin="10,8,10,0"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserResizeRows="False" SelectionMode="Extended"
                      Background="Transparent"
                      RowBackground="Transparent"
                      AlternatingRowBackground="Transparent"
                      HorizontalGridLinesBrush="#22FFFFFF"
                      SelectionChanged="FileList_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#33FFFFFF"/>
                        <Setter Property="BorderBrush" Value="#44FFFFFF"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="8,5"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="220"/>
                    <DataGridTextColumn Header="时长" Binding="{Binding DurationText}" Width="100"/>
                    <DataGridTextColumn Header="字幕" Binding="{Binding SubtitleText}" Width="80"/>
                    <DataGridTextColumn Header="格式" Binding="{Binding FormatText}" Width="100"/>
                    <DataGridTextColumn Header="预设" Binding="{Binding PresetText}" Width="90"/>
                    <DataGridTemplateColumn Header="状态" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 工具栏 -->
            <Grid Grid.Row="1" Margin="10,6,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="移除" Width="90" Height="30" Margin="0,0,8,0" Click="Remove_Click"/>
                <Button Grid.Column="1" Content="移除全部" Width="90" Height="30" Click="RemoveAll_Click"/>
                <Button Grid.Column="3" Content="快速设置" Width="90" Height="30" Margin="0,0,8,0" Click="QuickSettings_Click"/>
                <Button Grid.Column="4" Content="添加文件" Width="90" Height="30" Click="AddFiles_Click"/>
            </Grid>

            <!-- 输入/输出信息（固定高度） -->
            <Border Grid.Row="2" Height="90" Margin="10,0,10,6" Padding="10,8" CornerRadius="4"
                    Background="#33FFFFFF"
                    BorderBrush="#44FFFFFF"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InputInfoText" FontFamily="Consolas" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OutputInfoText" Grid.Column="1" Margin="16,0,0,0"
                               FontFamily="Consolas" FontSize="16" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- 底部 -->
            <Grid Grid.Row="3" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Content="源文件夹" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="保存在源文件夹中。" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="开始" Width="140" Height="34" Click="Start_Click"/>
            </Grid>
        </Grid>

        <!-- ================= 视图二：压制中 ================= -->
        <Grid x:Name="ProgressView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <StackPanel Grid.Row="0" Margin="10,8,10,4">
                <TextBlock x:Name="ProgressPercentText" FontSize="14" Text="[1] 0%"/>
                <TextBlock x:Name="ProgressFileName" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 上半部分：所有待压制文件 + 状态 -->
            <ItemsControl x:Name="ProgressFileList" Grid.Row="1" Margin="0,0,0,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="16" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                       Foreground="{Binding StatusBrush}" Margin="12,0,10,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 下半部分：左信息 / 右柱状图+按钮 -->
            <Grid Grid.Row="2" Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <Border Padding="10,8" CornerRadius="4" Background="#33FFFFFF"
                        BorderBrush="#44FFFFFF" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="DetFrameText" Foreground="#228B22" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="位置"/>
                            <TextBlock x:Name="DetPositionText" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="文件大小"/>
                            <TextBlock x:Name="DetSizeText" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="处理速率"/>
                            <TextBlock x:Name="DetSpeedText" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="已耗时"/>
                            <TextBlock x:Name="DetElapsedText" Grid.Column="1"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="剩余"/>
                            <TextBlock x:Name="DetRemainText" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="8,0,0,0" Padding="10,8" CornerRadius="4"
                        Background="#33FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Height="72" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ItemsControl x:Name="BitrateBars">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="4" Margin="0,0,1,0" VerticalAlignment="Bottom"
                                                   Height="{Binding Height}" Fill="#7FA0C0D0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock x:Name="MaxBitrateText" Grid.Row="1" Margin="0,6,0,6" Text="最大比特率: -"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button x:Name="PauseButton" Content="暂停" Width="80" Height="30" Margin="0,0,6,0" Click="Pause_Click"/>
                            <Button Content="强制停止" Width="90" Height="30" Margin="0,0,6,0" Click="ForceStop_Click"/>
                            <Button Content="停止" Width="80" Height="30" Click="Stop_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 全部进度 -->
            <Border Grid.Row="3" Margin="10,0,10,6" Padding="10,8" CornerRadius="4"
                    Background="#33FFFFFF" BorderBrush="#44FFFFFF" BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="AllText"/>
                    <ProgressBar x:Name="AllProgress" Height="10" Margin="0,8,0,8" Minimum="0" Maximum="100"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AllElapsedText"/>
                        <TextBlock x:Name="AllRemainText" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 全部按钮（关闭在右下角） -->
            <Grid Grid.Row="4" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="全部暂停" Width="140" Height="34" Margin="0,0,8,0" Click="PauseAll_Click"/>
                <Button Grid.Column="1" Content="全部强制停止" Width="150" Height="34" Margin="0,0,8,0" Click="ForceStopAll_Click"/>
                <Button Grid.Column="2" Content="全部停止" Width="140" Height="34" Click="StopAll_Click"/>
                <Button Grid.Column="4" Content="关闭" Width="140" Height="34" Click="CloseProgress_Click"/>
            </Grid>
        </Grid>
    </Grid>
</ui:Page>
